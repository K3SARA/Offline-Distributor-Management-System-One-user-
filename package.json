{
  "name": "offline-distributor-management",
  "version": "1.0.0",
  "description": "Offline-first Apple-inspired Desktop Distributor Management Application",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:vite": "vite --host",
    "dev:electron": "electron .",
    "dev": "concurrently -k -n \"SERVER,VITE\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:vite\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:vite": "vite build",
    "build": "node scripts/prepare-prisma.js && vite build && prisma generate",
    "build:all": "node scripts/prepare-prisma.js && vite build && prisma generate && npm run build:electron",
    "start": "node scripts/prepare-prisma.js && npx prisma db push --accept-data-loss && tsx server/index.ts",
    "start:electron": "cross-env NODE_ENV=production electron .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:wipe": "node scripts/wipe-data.js",
    "use:postgres": "node -e \"require('fs').copyFileSync('prisma/schema.postgresql.prisma', 'prisma/schema.prisma')\" && prisma generate",
    "use:sqlite": "node -e \"require('fs').writeFileSync('prisma/schema.prisma', require('fs').readFileSync('prisma/schema.prisma', 'utf8').replace(/provider = \\\"postgresql\\\"/, 'provider = \\\"sqlite\\\"'))\" && prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
